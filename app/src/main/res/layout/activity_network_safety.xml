<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#050812">

    <TextView
        android:id="@+id/networkTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Network Safety"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/networkStatusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Checking network..."
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#E5E7EB"
        android:paddingBottom="12dp" />

    <TextView
        android:id="@+id/networkDetailsText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="Details will appear here."
        android:textSize="14sp"
        android:textColor="#9CA3AF"
        android:lineSpacingExtra="4dp"
        android:paddingBottom="16dp" />

    <Button
        android:id="@+id/refreshNetworkButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Refresh Network Status"
        android:backgroundTint="#16A34A"
        android:textColor="@android:color/white" />

</LinearLayout>
